{
  "name": "responsive-react-actionsheet",
  "version": "1.1.0",
  "description": "Lightweight responsive action sheet for React web applications, with self-injecting styles and themeable colors",
  "author": "https://github.com/codeAesthetic",
  "license": "MIT",
  "repository": "https://github.com/codeAesthetic/react-action-sheet",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/index.css": "./dist/index.css",
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "styles": "node scripts/generate-styles.mjs",
    "prebuild": "npm run styles",
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "pretest": "npm run styles",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/generate-styles.mjs --check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/dist"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "javascript",
    "react",
    "reactjs",
    "action",
    "sheet",
    "action-sheet",
    "action sheet",
    "bottom-sheet",
    "web",
    "react-component",
    "frontend",
    "component",
    "components",
    "ui"
  ]
}
